# Copy to config/comfy.env and edit. Sourced by every script.
# The notebook writes this file for you from its form fields.

# ComfyUI lives on the Colab ephemeral disk (fast local NVMe).
COMFY_ROOT=/content/ComfyUI

# Persistent project folder on Google Drive.
DRIVE_ROOT=/content/drive/MyDrive/colab-comfy

# Weight cache on Drive. Empty disables caching entirely.
MODEL_CACHE=/content/drive/MyDrive/colab-comfy/models_cache

# Port ComfyUI listens on inside the runtime.
COMFY_PORT=8188

# tailscale | cloudflared | none
TUNNEL=tailscale
TS_HOSTNAME=colab-comfy

# Seconds between output syncs to Drive. 0 disables the sync loop.
SYNC_INTERVAL=30

# Extra flags for ComfyUI main.py, e.g. --highvram on an A100.
COMFY_EXTRA_ARGS=

# Secrets belong in the Colab secrets panel, not here:
#   TS_AUTHKEY  Tailscale auth key, required for TUNNEL=tailscale
#   HF_TOKEN    Hugging Face token, required for the gated LTX-2.5 repo
